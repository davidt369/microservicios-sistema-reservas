# ============================================================
# BASE DE DATOS OLTP (Supabase - Grupo 1)
# ============================================================
OLTP_HOST=aws-0-us-west-2.pooler.supabase.com
OLTP_DATABASE=postgres
OLTP_USER=usuario1.fgzrkjkflenmdmyfnkpr
OLTP_PASSWORD=your_password_here
OLTP_PORT=5432
OLTP_SSL=true

# ============================================================
# DATA WAREHOUSE (Neon PostgreSQL)
# ============================================================
DW_HOST=ep-orange-sun-aiyh4lhb.c-4.us-east-1.aws.neon.tech
DW_DATABASE=neondb
DW_USER=neondb_owner
DW_PASSWORD=npg_jr5fHxYAJU2S
DW_PORT=5432
DW_SSL=require

# ============================================================
# LIGHTDASH (BI Tool)
# ============================================================
LIGHTDASH_TOKEN=ldpat_0f41a27c36d4eed5235af44c71e88f5a
LIGHTDASH_URL=https://app.lightdash.cloud
LIGHTDASH_PROJECT_NAME=BI Hospital - Comparación OLAP

# ============================================================
# ETL Configuration
# ============================================================
ETL_BATCH_SIZE_DIMENSIONS=500
ETL_BATCH_SIZE_FACTS=1000
ETL_LOG_LEVEL=info
ETL_RETRY_ATTEMPTS=3

# ============================================================
# Node.js
# ============================================================
NODE_ENV=development
NODE_PORT=3000

# ============================================================
# DBT Configuration (para Lightdash)
# ============================================================
DBT_PROFILES_DIR=.
DBT_TARGET=dev
DBT_THREADS=4

# ============================================================
# Desarrollo/Testing
# ============================================================
DEBUG=false
ENABLE_BENCHMARKS=true
SKIP_DIM_VALIDATION=false
